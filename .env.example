# ─────────────────────────────────────────
# LLM — pick one provider; set LLM_PROVIDER accordingly
# ─────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openai              # openai | openrouter

# ─────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# Run locally with: docker compose up -d
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/arlo

# ─────────────────────────────────────────
# Web search
# ─────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────
# Discord
# ─────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_USER_ID=                 # Discord user ID of the single authorized user; messages from all others are silently dropped

# ─────────────────────────────────────────
# Proactive digest scheduler
# ─────────────────────────────────────────
DIGEST_TIME=09:00                # HH:MM format — morning brief time
EVENING_DIGEST_TIME=20:00        # HH:MM format — evening wrap-up time
DIGEST_TIMEZONE=America/Toronto  # IANA timezone string (e.g. America/New_York, Europe/London, Asia/Tokyo)

# ─────────────────────────────────────────
# App config
# ─────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
CONTEXT_WINDOW_SIZE=12           # number of recent messages passed as context to the agent
PROFILE_EXTRACTION_INTERVAL=10   # extract profile facts every N messages
MAX_REACT_ITERATIONS=8           # hard ceiling on the orchestrator ReAct loop
TASK_TOKEN_BUDGET=8000           # max tokens the orchestrator loop may consume; honest fallback on exceed

# Sub-agent budgets (separate from orchestrator)
RESEARCH_MAX_REACT_ITERATIONS=12
RESEARCH_TASK_TOKEN_BUDGET=12000
PLANNER_MAX_REACT_ITERATIONS=6
PLANNER_TASK_TOKEN_BUDGET=6000
PROACTIVE_MAX_REACT_ITERATIONS=5
PROACTIVE_TASK_TOKEN_BUDGET=8000

# Observation / snippet caps
TOOL_OBSERVATION_MAX_CHARS=2000  # truncate inline tool observations to this length
TAVILY_SNIPPET_MAX_CHARS=280     # per-result snippet length in web_search results
